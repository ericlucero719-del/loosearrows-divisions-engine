    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "npx prisma generate && npx tsc && cp -r public dist/ && mkdir -p dist/modules/dashboards && cp modules/dashboards/*.html dist/modules/dashboards/ && mkdir -p dist/modules/vendor-portal && cp modules/vendor-portal/*.html dist/modules/vendor-portal/ && mkdir -p dist/src/routes && cp src/routes/*.js dist/src/routes/",
    "start": "node dist/src/server.js",
    "test": "jest --runInBand",
    "shopify:sync": "ts-node scripts/buildShopifyDivisionCatalogs.ts",
    "shopify:categories": "ts-node scripts/buildShopifyCategoryCatalogs.ts",
    "shopify:build-catalogs": "ts-node scripts/buildCategoryCatalogs.ts",
    "shopify:bootstrap": "ts-node scripts/bootstrapStore.ts",
    "master": "ts-node master.ts",
    "seed:demo": "ts-node prisma/seeds/seed-demo.ts",
    "seed:catalog": "ts-node prisma/seeds/seed-catalog.ts"
  }
}
