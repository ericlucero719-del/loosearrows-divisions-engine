    "stripe-replit-sync": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.5.0",
    "@types/jest": "^30.0.0",
    "@types/mammoth": "^1.5.0",
    "@types/node": "^25.5.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
