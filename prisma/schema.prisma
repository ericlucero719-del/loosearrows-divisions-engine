// Prisma schema for Loose Arrows Divisions Engine (Division 2)
// This schema covers stores, products, suppliers, orders, purchase orders, and tracking.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id          String    @id @default(cuid())
  name        String
  url         String
  accessToken String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Store settings
  settings    StoreSettings?

  // Relations
  products         Product[]
  storeSuppliers   StoreSupplier[]
  orders           Order[]
}

model StoreSettings {
  id                     String  @id @default(cuid())
  store                  Store   @relation(fields: [storeId], references: [id])
  storeId                String  @unique

  // Stored as serialized JSON strings (SQLite does not support Json type directly)
  pricingRulesJson      String?
  supplierPriorityJson  String?
  shippingRulesJson     String?
  automationRulesJson   String?
  themePresetsJson      String?
  integrationsJson      String?
  updatedAt              DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  title       String
  description String?
  imagesJson  String?  // JSON array of image URLs
  cost        Float
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  suppliers   ProductSupplier[]
  store       Store?     @relation(fields: [storeId], references: [id])
  storeId     String?
  orderItems  OrderItem[]
}

model Supplier {
  id               String    @id @default(cuid())
  name             String
  contactEmail     String?
  apiEndpoint      String?
  portalUrl        String?
  cost             Float
  stock            Int       @default(0)
  leadTimeDays     Int
  reliabilityScore Float
  shippingSpeedDays Int
  location         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  storeSuppliers   StoreSupplier[]
  products         ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
}

model StoreSupplier {
  id         String   @id @default(cuid())
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  createdAt DateTime @default(now())
}

model ProductSupplier {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  createdAt DateTime @default(now())
}

model Order {
  id           String    @id @default(cuid())
  store        Store     @relation(fields: [storeId], references: [id])
  storeId      String
  customerJson String
  status       String    @default("created")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items         OrderItem[]
  tracking      Tracking?
  purchaseOrders PurchaseOrder[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitCost  Float
}

model PurchaseOrder {
  id             String    @id @default(cuid())
  order          Order     @relation(fields: [orderId], references: [id])
  orderId        String
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  supplierId     String
  status         String    @default("pending")
  poNumber       String    @unique
  shippingMethod String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  logs           PurchaseOrderLog[]
}

model PurchaseOrderLog {
  id           String    @id @default(cuid())
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  status       String
  message      String?
  createdAt    DateTime @default(now())
}

// ── Division 7: Vendor Registry (persistent) ──────────────────────────────────
model GovVendor {
  id                  String   @id @default(cuid())
  name                String
  categoriesJson      String   @default("[]")
  capabilitiesJson    String   @default("[]")
  performanceNotes    String?
  contactEmail        String?
  status              String   @default("active")
  linkedContractsJson String   @default("[]")
  linkedRequestsJson  String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── Division 2 module: Contract Registry (persistent) ─────────────────────────
model GovContract {
  contractId            String               @id @default(cuid())
  contractRef           String?
  contractName          String
  agency                String
  naics                 String?
  psc                   String?
  setAside              String?
  periodOfPerformance   String?
  status                String               @default("draft")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  products              GovContractProduct[]
  bids                  GovBid[]
}

model GovContractProduct {
  id            String      @id @default(cuid())
  contract      GovContract @relation(fields: [contractId], references: [contractId])
  contractId    String
  sku           String
  clin          String?
  contractPrice Float
  notes         String?

  @@unique([contractId, sku])
}

// ── Division 3: Bid Pipeline (persistent) ─────────────────────────────────────
model GovBid {
  bidId       String           @id @default(cuid())
  bidRef      String?
  contract    GovContract      @relation(fields: [contractId], references: [contractId])
  contractId  String
  requestId   String?
  vendorId    String
  vendorName  String?
  status      String           @default("DRAFT")
  totalValue  Float            @default(0)
  quoteId     String?
  quoteRef    String?
  notes       String?
  submittedAt DateTime?
  awardedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lineItems   GovBidLineItem[]
}

model GovBidLineItem {
  id          String  @id @default(cuid())
  bid         GovBid  @relation(fields: [bidId], references: [bidId])
  bidId       String
  sku         String
  clin        String?
  description String?
  quantity    Float
  unitPrice   Float
  extended    Float
}

// ── Division 3: Work Requests (persistent) ────────────────────────────────────
model GovWorkRequest {
  id           String   @id @default(cuid())
  type         String
  requestorId  String
  contractId   String?
  productIdsJson String  @default("[]")
  status       String   @default("New")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tracking {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id])
  orderId        String   @unique
  carrier        String?
  trackingNumber String?
  status         String?
  eta            DateTime?
  lastScan       DateTime?
  location       String?
  updatedAt      DateTime @updatedAt
}

// ── Division 1: Product Catalog & Pricing ─────────────────────────────────────
model GovProduct {
  productId     String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  category      String?
  unitOfMeasure String?
  cost          Float
  price         Float
  marginPct     Float    @default(0)
  naics         String?
  notes         String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Division 6: Compliance & Documentation ────────────────────────────────────
model GovComplianceDoc {
  docId      String   @id @default(cuid())
  docRef     String   @unique
  docType    String
  title      String
  issuer     String?
  identifier String?
  status     String   @default("ACTIVE")
  issuedDate String?
  expiryDate String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Division 8: Agency & Customer Management ──────────────────────────────────
model GovAgency {
  agencyId     String                 @id @default(cuid())
  name         String
  agencyType   String?
  department   String?
  naicsJson    String                 @default("[]")
  status       String                 @default("active")
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  contacts     GovAgencyContact[]
  interactions GovAgencyInteraction[]
}

model GovAgencyContact {
  contactId String    @id @default(cuid())
  agency    GovAgency @relation(fields: [agencyId], references: [agencyId], onDelete: Cascade)
  agencyId  String
  name      String
  title     String?
  email     String?
  phone     String?
  role      String?
  notes     String?
  createdAt DateTime  @default(now())
}

model GovAgencyInteraction {
  interactionId String    @id @default(cuid())
  agency        GovAgency @relation(fields: [agencyId], references: [agencyId], onDelete: Cascade)
  agencyId      String
  type          String
  contractRef   String?
  bidRef        String?
  summary       String
  createdAt     DateTime  @default(now())
}

// ── Division 4: Purchase Orders (post-award) ──────────────────────────────────
model GovPO {
  poId        String        @id @default(cuid())
  poRef       String        @unique
  bidId       String?
  contractId  String?
  vendorId    String?
  vendorName  String?
  agencyName  String?
  status      String        @default("DRAFT")
  totalValue  Float         @default(0)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lineItems   GovPOLineItem[]
  shipments   GovShipment[]
  invoices    GovInvoice[]
}

model GovPOLineItem {
  id          String  @id @default(cuid())
  po          GovPO   @relation(fields: [poId], references: [poId], onDelete: Cascade)
  poId        String
  sku         String
  clin        String?
  description String?
  quantity    Float
  unitPrice   Float
  extended    Float
}

// ── Division 5: Shipments & Fulfillment ───────────────────────────────────────
model GovShipment {
  shipmentId       String    @id @default(cuid())
  shipRef          String    @unique
  poId             String?
  po               GovPO?    @relation(fields: [poId], references: [poId])
  bidId            String?
  vendorId         String?
  vendorName       String?
  carrier          String?
  trackingNumber   String?
  deliveryLocation String?
  expectedDelivery String?
  deliveredAt      String?
  status           String    @default("PENDING")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ── Division 9: Invoices & Financials ─────────────────────────────────────────
model GovInvoice {
  invoiceId   String              @id @default(cuid())
  invoiceRef  String              @unique
  bidId       String?
  poId        String?
  po          GovPO?              @relation(fields: [poId], references: [poId])
  vendorId    String?
  vendorName  String?
  agencyName  String?
  status      String              @default("DRAFT")
  totalAmount Float               @default(0)
  paidAmount  Float               @default(0)
  dueDate     String?
  paidAt      String?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lineItems   GovInvoiceLineItem[]
}

model GovInvoiceLineItem {
  id          String     @id @default(cuid())
  invoice     GovInvoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  invoiceId   String
  sku         String?
  clin        String?
  description String?
  quantity    Float
  unitPrice   Float
  extended    Float
}

// ── API Key Access Control ─────────────────────────────────────────────────────
model ApiKey {
  id          String    @id @default(cuid())
  key         String    @unique
  tier        String    // OBSERVER | OPERATOR | ARCHITECT
  ownerName   String
  ownerEmail  String?
  active      Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
}

// ── TikTok Sales Automation Layer ─────────────────────────────────────────────
model TikTokOrder {
  orderId       String   @id @default(cuid())
  externalId    String   @unique
  status        String   @default("RECEIVED")
  itemsJson     String   @default("[]")
  skuMatchJson  String   @default("[]")
  profitUsd     Float    @default(0)
  feeRate       Float    @default(0.0075)
  feeAmountUsd  Float    @default(0)
  vendorId      String?
  vendorName    String?
  poId          String?
  shipmentId    String?
  invoiceId     String?
  fulfillMethod String?
  trackingRef   String?
  carrier       String?
  labelRef      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Multi-Platform Commerce Automation Layer ───────────────────────────────────
// Shared table for Instagram, YouTube, Amazon, and future e-commerce platforms.
// Platform discrimination via `platform` field (INSTAGRAM | YOUTUBE | AMAZON | ...).
model CommerceOrder {
  orderId       String   @id @default(cuid())
  platform      String
  externalId    String
  status        String   @default("RECEIVED")
  itemsJson     String   @default("[]")
  skuMatchJson  String   @default("[]")
  profitUsd     Float    @default(0)
  vendorId      String?
  vendorName    String?
  poId          String?
  shipmentId    String?
  invoiceId     String?
  fulfillMethod String?
  trackingRef   String?
  carrier       String?
  labelRef      String?
  channel       String?
  feeRate       Float    @default(0.0075)   // default 0.75% of contract value
  feeAmountUsd  Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([platform])
  @@index([status])
}

// ── SAM.gov Opportunity Watchlist ─────────────────────────────────────────────
model SamOpportunity {
  id              String   @id @default(cuid())
  noticeId        String   @unique
  title           String
  agency          String?
  naicsCode       String?
  postedDate      String?
  responseDeadline String?
  setAside        String?
  placeOfPerf     String?
  description     String?
  solicitationNum String?
  awardAmount     Float?
  status          String   @default("OPEN")    // OPEN | WATCHING | BIDDING | WON | LOST
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Billing / Fee Configuration ───────────────────────────────────────────────
model BillingConfig {
  id          String   @id @default(cuid())
  platform    String   @unique  // TIKTOK | INSTAGRAM | YOUTUBE | AMAZON | SHOPIFY | DEFAULT
  feeRate     Float    @default(0.0075)  // 0.75%
  minFeeUsd   Float    @default(25)
  maxFeeUsd   Float?
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Crypto / Bitcoin Engine ───────────────────────────────────────────────────

model CryptoTreasury {
  id            String   @id @default(cuid())
  asset         String                         // BTC | ETH | USDC | SOL
  action        String                         // DEPOSIT | WITHDRAW | FEE_COLLECT
  amountCrypto  Float                          // units of the asset
  priceUsdAt    Float                          // USD price per unit at time of action
  valueUsd      Float                          // amountCrypto * priceUsdAt
  notes         String?
  txHash        String?
  source        String?                        // INVOICE | FEE | MANUAL | COMMERCE
  sourceRef     String?                        // invoice ID, order ID, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CryptoPayment {
  id            String   @id @default(cuid())
  invoiceId     String?
  commerceRef   String?
  asset         String                         // BTC | ETH | USDC
  amountCrypto  Float
  amountUsd     Float
  priceUsdAt    Float
  txHash        String?
  status        String   @default("PENDING")  // PENDING | CONFIRMED | FAILED
  paymentNote   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Reseller Network ──────────────────────────────────────────────────────────

model Reseller {
  id              String   @id @default(cuid())
  resellerRef     String   @unique                  // RSL-001, RSL-002 ...
  name            String
  email           String   @unique
  platform        String   @default("TIKTOK")       // TIKTOK | INSTAGRAM | SHOPIFY
  apiKey          String   @unique                  // auto-generated la-rsl-...
  tier            String   @default("STARTER")      // STARTER | STANDARD | PROFESSIONAL | ELITE
  feeRate         Float    @default(0.015)           // tier-based fee rate
  status          String   @default("ACTIVE")        // ACTIVE | SUSPENDED | PENDING
  totalGmv        Float    @default(0)              // lifetime gross GMV
  totalFeesPaid   Float    @default(0)              // lifetime fees paid to platform
  totalEarnings   Float    @default(0)              // lifetime net earnings
  pendingPayout   Float    @default(0)              // unpaid balance
  monthlyGmv      Float    @default(0)              // rolling 30-day GMV (for tier calc)
  btcWalletAddress String?                          // for BTC payouts
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payouts         ResellerPayout[]
}

model ResellerPayout {
  id           String   @id @default(cuid())
  resellerId   String
  reseller     Reseller @relation(fields: [resellerId], references: [id])
  amount       Float                              // USD paid out
  method       String   @default("ACH")           // ACH | CRYPTO_USDC | CRYPTO_BTC | CHECK
  status       String   @default("PENDING")       // PENDING | PROCESSING | PAID | FAILED
  reference    String?                            // bank ref, tx hash, check number
  periodStart  String?
  periodEnd    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Lightning Network Payments ────────────────────────────────────────────────

model LightningInvoice {
  id            String   @id @default(cuid())
  invoiceRef    String   @unique             // LN-0001 ...
  amountSats    Int                          // satoshis
  amountUsd     Float                        // USD equivalent at creation
  btcPriceAtCreation Float
  description   String?
  paymentHash   String?                      // BOLT11 payment_hash
  bolt11        String?                      // full BOLT11 invoice string
  status        String   @default("PENDING") // PENDING | PAID | EXPIRED | CANCELLED
  linkedRef     String?                      // contract/PO/reseller ref
  linkedType    String?                      // INVOICE | PO | RESELLER | GENERAL
  paidAt        DateTime?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── BTC-Backed Credit Lines ───────────────────────────────────────────────────

model BtcCreditLine {
  id                String   @id @default(cuid())
  creditRef         String   @unique            // CL-0001 ...
  purpose           String                      // "Supplier payment for contract X", etc
  btcCollateral     Float                       // BTC deposited as collateral
  btcPriceAtOpen    Float                       // BTC price when line opened
  collateralUsd     Float                       // btcCollateral × btcPriceAtOpen
  ltvRatio          Float    @default(0.5)      // loan-to-value (50% = conservative)
  creditLimitUsd    Float                       // collateralUsd × ltvRatio
  drawnUsd          Float    @default(0)        // amount actually borrowed
  repaidUsd         Float    @default(0)        // amount repaid
  outstandingUsd    Float    @default(0)        // drawn - repaid
  interestRatePct   Float    @default(8.0)      // annual interest rate %
  accruedInterestUsd Float   @default(0)
  status            String   @default("OPEN")   // OPEN | REPAID | LIQUIDATED | CLOSED
  lender            String?                     // BlockFi, Nexo, Unchained, etc
  linkedContractRef String?
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  repayments        CreditRepayment[]
}

model CreditRepayment {
  id           String        @id @default(cuid())
  creditLineId String
  creditLine   BtcCreditLine @relation(fields: [creditLineId], references: [id])
  amountUsd    Float
  type         String        @default("PRINCIPAL") // PRINCIPAL | INTEREST | FULL
  reference    String?
  notes        String?
  createdAt    DateTime      @default(now())
}
